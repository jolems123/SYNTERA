      "id": "Y2028", "year": 2028,
      "rules": [
        { "label": "Loopline dividend", "stat": "credits", "delta": 20 },
        { "label": "Data-licence dividend bonus", "stat": "credits", "delta": 25, "whenAll": [ { "flag": "vantageDataLicense", "is": true } ] },
