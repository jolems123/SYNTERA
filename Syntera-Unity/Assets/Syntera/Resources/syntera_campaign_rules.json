          "business": [ { "seats": 1, "whenAny": [ [ { "stat": "grid", "min": 60 } ] ] } ],
          "mayor": [ { "seats": 2, "whenAny": [ [ { "stat": "mayor", "min": 50 } ] ] }, { "seats": 1, "whenAny": [ [ { "stat": "mayor", "min": 40 } ] ] } ],
