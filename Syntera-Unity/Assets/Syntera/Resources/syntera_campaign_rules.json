{
  "schemaVersion": 1,
  "scriptVersion": "1.1",
  "source": "SYNTERA The Last Human Decision, 90 Minute Screenplay v1.1, sections 5, 6, 7 and 14. GAME DESIGN numbers, not real economic forecasts.",
  "start": {
    "stats": {
      "credits": 150, "treasury": 160, "trust": 50, "jobs": 50, "autonomy": 50, "grid": 55, "vantageInfluence": 30,
