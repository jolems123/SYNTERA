          "business": [ { "seats": 3, "whenAny": [ [ { "stat": "vantageInfluence", "min": 45 } ], [ { "stat": "jobs", "min": 58 } ] ] }, { "seats": 1, "whenAny": [ [ { "stat": "vantageInfluence", "min": 40 } ] ] } ],
