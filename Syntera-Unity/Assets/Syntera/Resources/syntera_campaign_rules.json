          "nansubuga": [ { "seats": 1, "whenAny": [ [ { "stat": "evidence", "min": 5 } ] ] } ]
        }
      },
      {
        "id": "compact", "title": "Optimization Compact", "ending": "CorporateSunrise",
        "summary": "Licensed AI administration with targets, audited outcomes and enforceable termination rights.",
